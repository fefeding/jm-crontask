    "@midwayjs/busboy": "^3.20.15",
    "@midwayjs/cache-manager": "^3.20.11",
    "@midwayjs/cli": "^2.1.1",
    "@midwayjs/code-dye": "^3.20.12",
    "@midwayjs/core": "^3.20.11",
    "@midwayjs/decorator": "^3.20.11",
    "@midwayjs/info": "^3.20.16",
    "@midwayjs/koa": "^3.20.16",
    "@midwayjs/logger": "^4.0.1",
    "@midwayjs/static-file": "^3.20.16",
    "@midwayjs/swagger": "^3.20.16",
    "@midwayjs/typeorm": "^3.20.11",
    "@midwayjs/validate": "^3.20.16",
    "@midwayjs/view-nunjucks": "^3.20.16",
    "@tars/config": "^2.0.5",
    "@tars/rpc": "^2.0.15",
    "axios": "^1.10.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.2",
    "ip": "^2.0.1",
    "jm-jsruntime": "^1.0.7",
    "moment": "^2.30.1",
    "mysql2": "^3.14.5",
    "pino": "^9.7.0",
    "swagger-ui-dist": "^5.0.0",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
