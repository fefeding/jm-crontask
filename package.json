  "devDependencies": {
    "@cicctencent/tars-deploy": "^1.0.8",
    "@jest/globals": "^30.0.5",
    "@midwayjs/mock": "^3.20.11",
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.0",
    "cross-env": "^10.0.0",
    "jest": "^30.0.5",
    "mwts": "^1.3.0",
    "mwtsc": "^1.4.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:midway": "cross-env NODE_ENV=local midway-bin dev --ts",
    "dev:vue": "cd web && npm run dev",
    "dev:all": "npm-run-all -p dev:vue dev:midway",
    "dev": "sh ./bin/dev.sh",
    "test": "midway-bin test --ts",
    "cov": "midway-bin cov --ts",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build:vue": "cd web && npm run build",
    "build:midway": "midway-bin build -c",
    "build": "sh ./bin/build.sh",
    "zip": "rm -rf server.zip && zip -r server.zip ./dist ./package.json ./bootstrap.js",
    "tars:deploy": "cross-env PKG_DEPLOY_NAME=WebServer sh ./bin/deploy.sh",
    "deploy": "npm install && npm run build && npm prune --production",
    "docker": "docker build . -t base-server",
    "start": "pm2 start bootstrap.js --name crontask-server --disable-logs",
    "restart": "pm2 restart crontask-server --disable-logs",
    "stop": "pm2 stop crontask-server"
  },
  "midway-bin-clean": [
    ".vscode/.tsbuildinfo",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "anonymous",
  "license": "MIT"
}
