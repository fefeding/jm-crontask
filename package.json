{
  "name": "crontask",
  "version": "0.0.1",
  "description": "CronTask - 基于 Midway.js + Vue3 的分布式定时任务管理系统",
  "private": false,
  "keywords": [
    "cron",
    "task",
    "scheduler",
    "timed-task",
    "midway",
    "vue",
    "typescript"
  ],
  "dependencies": {
    "@cicctencent/base-server": "0.1.8",
    "@cicctencent/common": "^1.0.75",
    "@cicctencent/midwayjs-base": "^1.1.0",
    "@fefeding/typeorm-storage": "^0.1.11",
    "@hardik_sharma/cron-parser-all": "^0.0.2",
    "@midwayjs/axios": "^3.20.24",
    "@midwayjs/bootstrap": "^3.20.24",
    "@midwayjs/busboy": "^3.20.24",
    "@midwayjs/cache-manager": "^3.20.24",
    "@midwayjs/cli": "^2.1.1",
    "@midwayjs/code-dye": "^3.20.24",
    "@midwayjs/core": "^3.20.24",
    "@midwayjs/decorator": "^3.20.24",
    "@midwayjs/info": "^3.20.24",
    "@midwayjs/koa": "^3.20.24",
    "@midwayjs/logger": "^4.1.0",
    "@midwayjs/static-file": "^3.20.24",
    "@midwayjs/swagger": "^3.20.24",
    "@midwayjs/typeorm": "^3.20.24",
    "@midwayjs/validate": "^3.20.24",
    "@midwayjs/view-nunjucks": "^3.20.24",
    "@tars/config": "^2.0.5",
    "@tars/rpc": "^2.0.15",
    "axios": "^1.21.0",
    "blueimp-md5": "^2.19.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "ip": "^2.0.1",
    "jm-jsruntime": "^1.0.7",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "mysql2": "^3.24.6",
    "pino": "^9.14.0",
    "swagger-ui-dist": "^5.34.1",
    "typeorm": "^0.3.31",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@cicctencent/tars-deploy": "^1.0.10",
    "@jest/globals": "^30.5.2",
    "@midwayjs/mock": "^3.20.24",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "get-port": "^5.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^15.5.2",
    "mwts": "^1.3.0",
    "mwtsc": "^1.16.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "init": "node bin/init.js",
    "prepare": "husky",
    "install:all": "cd web && npm install && cd .. && npm install",
    "install:all:pnpm": "cd web && pnpm install && cd .. && pnpm install",
    "dev:midway": "cross-env NODE_ENV=local midway-bin dev --ts",
    "dev:vue": "cd web && npm run dev",
    "dev:all": "npm-run-all -p dev:vue dev:midway",
    "dev": "node bin/dev.js",
    "test": "midway-bin test --ts",
    "cov": "midway-bin cov --ts",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build:vue": "cd web && npm run build",
    "build:midway": "midway-bin build -c",
    "build": "node bin/build.js",
    "zip": "node bin/zip.js",
    "db:migrate": "node bin/migrate.js",
    "tars:deploy": "cross-env PKG_DEPLOY_NAME=WebServer sh ./bin/deploy.sh",
    "deploy": "npm install && npm run build && npm prune --production",
    "docker": "docker build . -t base-server",
    "start": "pm2 start bootstrap.js --name crontask-server --disable-logs",
    "restart": "pm2 restart crontask-server --disable-logs",
    "stop": "pm2 stop crontask-server",
    "dk-start": "pm2-runtime start bootstrap.js --name base-server",
    "dk-restart": "pm2-runtime restart base-server",
    "dk-stop": "pm2-runtime stop base-server",
    "start-docker": "docker run -d -p 8000:8000 -v $(pwd)/.env:/app/.env --name base-server base-server"
  },
  "midway-bin-clean": [
    ".vscode/.tsbuildinfo",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/yc_null/base/crontask"
  },
  "homepage": "https://cnb.cool/yc_null/base/crontask",
  "bugs": {
    "url": "https://cnb.cool/yc_null/base/crontask/-/issues"
  },
  "author": "yc_null",
  "license": "MIT"
}
