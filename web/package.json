{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fix:vite-nunjucks-plugin": "node -e \"const fs=require('fs'); const path=require('path'); const pkgPath=path.join(process.cwd(),'node_modules','@fefeding','vite-nunjucks-plugin','package.json'); if(!fs.existsSync(pkgPath)){ process.exit(0); } const pkg=JSON.parse(fs.readFileSync(pkgPath,'utf8')); if(pkg.type!=='module'){ pkg.type='module'; fs.writeFileSync(pkgPath, JSON.stringify(pkg,null,2)); }\"",
    "postinstall": "npm run fix:vite-nunjucks-plugin",
    "predev": "npm run fix:vite-nunjucks-plugin",
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prebuild-only": "npm run fix:vite-nunjucks-plugin",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write \"src/**/*.{vue,js,ts,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,js,ts,json,css,scss,md}\""
  },
  "dependencies": {
    "@cicctencent/common": "^1.0.75",
    "@fefeding/eventemitter": "^1.0.4",
    "@fefeding/utils": "^1.0.39",
    "@popperjs/core": "^2.11.8",
    "@vueuse/core": "^13.9.0",
    "ace-builds": "^1.43.4",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "js-cookie": "^3.0.8",
    "jszip": "^3.10.2",
    "lodash-es": "^4.18.1",
    "no-vue3-cron": "^2.0.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vue3-ace-editor": "^2.2.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@fefeding/vite-nunjucks-plugin": "^1.0.2",
    "@rollup/pluginutils": "^5.5.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/bootstrap": "^5.2.11",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-files-copy": "^3.8.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.14"
  }
}
