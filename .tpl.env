# ==========================================================================
# CronTask 环境变量模板
#
# 用法：cp .tpl.env .env 后按需修改
#       （.env 含密钥，已被 .gitignore 忽略，切勿提交到仓库）
#
# 最关键的两个开关：
#   JSON_STORAGE —— 是否使用本地 JSON 回退存储（决定要不要 MySQL）
#   SSO_ENABLED  —— 登录是否走 SSO（本地体验可关闭，用默认管理员登录）
# ==========================================================================

# ---------- 服务端口 ----------
# 后端 Midway 服务端口，浏览器访问此端口
PORT=8092
# 前端 Vite 端口（仅用于模块加载 / HMR，不是浏览器入口）
# 必须配置：后端渲染页面时据此生成 <base href="//<hostname>:VITE_PORT">，
# 缺失会导致 <base href=""> 为空，浏览器把 /src/... 模块请求打到后端端口而非 Vite，
# 表现为「页面白屏 + 后端端口上模块 404」。
VITE_PORT=5173

# ---------- 基础 ----------
APP_ID=2
API_KEY="2024"
BASE_SERVER_URL=
LOG_LEVEL=info
REMOTE_LOGGER_URL=
# 跨域白名单（逗号分隔）
WHITE_DOMAINS=127.0.0.1,localhost

# ---------- 部署路径与标题 ----------
# 部署到子路径时才需要填写（如 PREFIX=crontask，则接口地址变为 /crontask/api）
# 留空表示部署在根路径
PREFIX=crontask
TITLE=计划任务系统

# ---------- 登录与会话 ----------
# 管理员初始密码（首次启动播种 baseService.manager 账号时使用）
DEFAULT_ADMIN_PASSWORD=df123456
# Session 过期时间（毫秒），默认 20 分钟（1200000）；设为 0 表示不过期（不推荐）
SESSION_TIMEOUT=1200000
# JWT 签名密钥：会话签发与校验必须使用同一密钥，否则鉴权必然失败。
# 生产环境务必改成随机值（如 openssl rand -hex 32）
SESSION_SECRET_KEY=fefeding

# ---------- SSO / OIDC 单点登录 ----------
# 旧版 SSO 入口（保留项，按需填写）
SSO_URL=
# 是否启用 SSO 登录 (true/false)
# 本地体验可设为 false，改用上面的 DEFAULT_ADMIN_PASSWORD 登录
SSO_ENABLED=false
# SSO 服务基础 URL
SSO_BASE_URL=
# OAuth API 基础 URL (可选，默认使用 SSO_BASE_URL)
SSO_OAUTH_API_BASE_URL=
# OAuth 客户端 ID (需要从 SSO 系统获取)
SSO_CLIENT_ID=work-agent
# OAuth 客户端密钥 (需要从 SSO 系统获取)
SSO_CLIENT_SECRET=work-agent-2026
# OAuth 回调地址 (可选，默认使用当前服务的 /api/session/sso/callback)
SSO_REDIRECT_URI=
# OAuth scope (可选，默认 openid profile email)
SSO_SCOPE=openid profile email
# 登录成功后跳转地址 (可选，默认 /admin/index)
SSO_SUCCESS_REDIRECT=
# 是否自动创建用户 (true/false，默认 true)
SSO_AUTO_CREATE_USER=true

# ---------- 存储（MySQL / 本地 JSON 回退） ----------
# 默认使用本地 JSON 回退存储：数据落盘到 <项目根>/data/db/<表名>/<主键>.json，
# 业务 TypeORM 代码零改动，无需安装 MySQL，开箱即用。
# 切换到 MySQL：把下面 JSON_STORAGE 改为 mysql，并填好下方 DB_* 配置，再执行 npm run db:migrate。
JSON_STORAGE=local
# JSON 存储目录（可选，留空默认 <项目根>/data/db）
# JSON_STORAGE_DIR=/absolute/path/to/dir
# 强制不连数据库启动（等价于 JSON_STORAGE=local），仅用于纯前端开发
DISABLE_DB=false

# ---------- 数据库（仅在 JSON_STORAGE=mysql 时生效） ----------
DB_HOST=
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=db_crontask
